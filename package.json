{
  "name": "scalex-launchpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "pnpm --filter admin-portal dev",
    "dev:student": "pnpm --filter student-portal dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:types": "node scripts/generate-types.mjs",
    "db:seed-test-users": "node scripts/seed-test-users.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  }
}
