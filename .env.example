# Payment plan (70/30 split — configurable, not hardcoded in code)
PAYMENT_FIRST_PERCENT=70
PAYMENT_REMAINING_PERCENT=30
PAYMENT_PLAN_TOTAL_CENTS=99700

# Resend transactional email (server-side only — never expose client-side)
RESEND_API_KEY=
EMAIL_FROM=ScaleX LaunchPad <noreply@scalexlms.com>
EMAIL_LOGO_URL=https://www.scalexlms.com/scalex-logo-transparent.png
EMAIL_SITE_URL=https://www.scalexlms.com
# Pepper for hashing password-reset OTPs
OTP_PEPPER=
# Protects /api/cron/* routes (Vercel Cron Authorization: Bearer <secret>)
CRON_SECRET=

